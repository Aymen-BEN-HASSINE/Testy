# --- IA (Anthropic / Claude) ---
# Cle API obtenue sur https://platform.claude.com
ANTHROPIC_API_KEY=sk-ant-...
# Modele Claude utilise pour la generation (par defaut: claude-opus-4-8)
CLAUDE_MODEL=claude-opus-4-8

# --- Shopify Admin API ---
# Domaine de la boutique, ex: ma-boutique.myshopify.com
SHOPIFY_STORE_DOMAIN=
# Token d'acces Admin API (Custom app -> Admin API access token, prefixe shpat_)
SHOPIFY_ADMIN_ACCESS_TOKEN=
# Version de l'API Admin Shopify
SHOPIFY_API_VERSION=2024-10

# --- Recherche fournisseurs ---
# Fournisseur de donnees: "mock" (par defaut, donnees de demonstration) ou "custom"
SUPPLIER_PROVIDER=mock
